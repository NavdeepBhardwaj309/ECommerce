{
  "ReverseProxy": {
    "Routes": {
      "identity-route": {
        "ClusterId": "identity-cluster",
        "Match": { "Path": "/api/identity/{**catch-all}" }
      },
      "products-route": {
        "ClusterId": "product-cluster",
        "Match": { "Path": "/api/products/{**catch-all}" }
      },
      "cart-route": {
        "ClusterId": "cart-cluster",
        "Match": { "Path": "/api/cart/{**catch-all}" }
      },
      "orders-route": {
        "ClusterId": "order-cluster",
        "Match": { "Path": "/api/orders/{**catch-all}" }
      },
      "payments-route": {
        "ClusterId": "payment-cluster",
        "Match": { "Path": "/api/payment/{**catch-all}" }
      }
    },
    "Clusters": {
      "identity-cluster": { "Destinations": { "destination1": { "Address": "http://localhost:5101/" } } },
      "product-cluster": { "Destinations": { "destination1": { "Address": "http://localhost:5102/" } } },
      "cart-cluster": { "Destinations": { "destination1": { "Address": "http://localhost:5103/" } } },
      "order-cluster": { "Destinations": { "destination1": { "Address": "http://localhost:5104/" } } },
      "payment-cluster": { "Destinations": { "destination1": { "Address": "http://localhost:5106/" } } }
    }
  }
}{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
